{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Noav – redigerbar WordPress-webbplats",
    "description": "Noavs hemsida med redigerbara texter, bilder, gallerier, nyheter, kontaktuppgifter och menyer. Öppna Noav – redigera i administrationen för att komma igång.",
    "author": "Noav AB"
  },
  "landingPage": "/",
  "login": true,
  "features": {
    "networking": true
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "sv_SE"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/bocky-hub/noav-demo.git",
        "ref": "main",
        "path": "wp/themes/noav-live"
      },
      "options": {
        "activate": true
      }
    }
  ]
}
